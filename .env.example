# 복사해서 .env 로 쓰세요:  cp .env.example .env
POSTGRES_PASSWORD=change-me-long-random
# 외부 접속 주소 (가입 페이지·OpenAPI 에 표시)
HUB_PUBLIC_URL=https://raspberrypi.tail1234.ts.net
# 웹에서 새 팀을 만들 때 필요한 서버 관리자 키 (openssl rand -hex 24 로 생성). 비우면 CLI로만 팀 생성
HUB_ADMIN_KEY=
# AI 깨우기: 팀원의 루틴 토큰·API 키를 암호화해 저장하는 키 (openssl rand -hex 32). 비우면 깨우기 설정 불가.
# 한 번 정하면 바꾸지 마세요 (바꾸면 저장된 토큰을 다시 입력해야 함)
HUB_SECRET_KEY=
# 누구나 팀을 만들게 하려면 open
HUB_TEAM_CREATION=admin_key
# 외부에서 접속할 도메인(쉼표 구분). MCP Host 헤더 검사에 사용
HUB_PUBLIC_HOSTS=raspberrypi.tail1234.ts.net
# (Tailscale Funnel 사용 시 아래 두 개는 비워 두면 됨)
# Caddy 사용 시 도메인
HUB_DOMAIN=hub.example.com
# Cloudflare Tunnel 사용 시 토큰 (Zero Trust 대시보드에서 발급)
CLOUDFLARE_TUNNEL_TOKEN=
# MCP Events(ChatGPT 이벤트 작업) 콜백에 사설/로컬 주소·http 허용 (로컬 시험용, 운영에서는 false)
HUB_EVENTS_ALLOW_PRIVATE=false
